[Unit]
Description=CertMgr API (FastAPI/uvicorn)
After=network-online.target postgresql.service redis.service
Wants=network-online.target

[Service]
Type=simple
User=certmgr
Group=certmgr
WorkingDirectory=/opt/certmgr/backend
EnvironmentFile=/etc/certmgr/certmgr.env
# Required for Prometheus metrics to reflect reality: certmgr-api (4 uvicorn
# workers) and certmgr-worker are separate processes, each with its own
# in-memory Counter/Gauge state, so a plain /metrics scrape from one API
# worker would never see certbot/job activity that happened in the worker
# process. This makes every process write to a shared mmap directory
# instead, which /metrics then aggregates across (see app/main.py).
# Must match the same path in certmgr-worker.service. chmod 1777 (not a
# chgrp to some assumed shared group) because this unit and
# certmgr-worker.service may run as different, unrelated service accounts
# — e.g. the documented worker-as-root override runs the worker as root
# while this unit stays on an unprivileged account with a different name
# entirely (this directory holds nothing but local metric mmap files, so
# world-writable is an acceptable tradeoff — same convention /tmp uses;
# the sticky bit still stops one account from deleting another's files).
Environment=PROMETHEUS_MULTIPROC_DIR=/var/lib/certmgr/prometheus_multiproc
ExecStartPre=/usr/bin/mkdir -p /var/lib/certmgr/prometheus_multiproc
# "-" prefix: chmod only succeeds for the owner or root, and if
# certmgr-worker created this directory first (e.g. running as root under
# the worker-as-root override) while this unit runs as a different,
# unprivileged account, this attempt will fail — that's fine, a failing
# ExecStartPre would otherwise block startup entirely, and
# certmgr-worker.service's own chmod (which runs as root there and always
# succeeds regardless of ownership) is what actually needs to be reliable.
ExecStartPre=-/usr/bin/chmod 1777 /var/lib/certmgr/prometheus_multiproc
# Sweeps shard files left behind by PIDs that no longer exist (previous
# restarts/crashes) before the new 4 workers start writing — otherwise
# their stale last-known values linger forever in the "mostrecent"
# multiprocess aggregate and /metrics drifts out of sync with the live
# database. Only ever removes files for provably-dead PIDs, so it never
# races certmgr-worker.service's own sweep of the same shared directory.
ExecStartPre=-/opt/certmgr/backend/.venv/bin/python /opt/certmgr/backend/scripts/cleanup_stale_metrics.py /var/lib/certmgr/prometheus_multiproc
ExecStartPre=/opt/certmgr/backend/.venv/bin/alembic upgrade head
ExecStart=/opt/certmgr/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 4 --proxy-headers
Restart=on-failure
RestartSec=5
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/certmgr /var/log/certmgr /etc/letsencrypt
AmbientCapabilities=
CapabilityBoundingSet=
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target

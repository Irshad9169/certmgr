[Unit]
Description=CertMgr data retention (execution history / audit / notifications)
After=network-online.target postgresql-16.service mariadb.service redis.service

[Service]
Type=oneshot
User=certmgr
Group=certmgr
WorkingDirectory=/opt/certmgr/backend
EnvironmentFile=/etc/certmgr/certmgr.env
ExecStart=/opt/certmgr/backend/.venv/bin/python -m cli.certmgr retention
StandardOutput=append:/var/log/certmgr/retention.log
StandardError=append:/var/log/certmgr/retention.log
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/certmgr /var/log/certmgr /etc/letsencrypt

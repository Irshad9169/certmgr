# ── CertMgr environment configuration (copy to .env) ────────────────────────
CERTMGR_ENVIRONMENT=production
CERTMGR_DEBUG=false

# Security — MUST be set in production (>= 32 chars)
CERTMGR_SECRET_KEY=change-me-to-a-long-random-string
CERTMGR_SECRETS_MASTER_KEY=change-me-32-chars-minimum-xxxxxxxx
# Prefer a key file: CERTMGR_SECRETS_ENCRYPTION_FILE=/run/secrets/certmgr_master_key

CERTMGR_ACCESS_TOKEN_EXPIRE_MINUTES=30
CERTMGR_REFRESH_TOKEN_EXPIRE_DAYS=14
CERTMGR_COOKIE_SECURE=true
CERTMGR_CSRF_ENABLED=true
CERTMGR_MFA_REQUIRED=false
CERTMGR_PASSWORD_MIN_LENGTH=12

# Database / Redis / Celery
# Primary: PostgreSQL 12+
CERTMGR_DATABASE_URL=postgresql+psycopg://certmgr:certmgr@127.0.0.1:5432/certmgr
# Fallback: MariaDB 10.5+ / MySQL 8 (fully supported, dialect-safe SQL + mysqldump backups)
# CERTMGR_DATABASE_URL=mysql+pymysql://certmgr:certmgr@127.0.0.1:3306/certmgr
# Dev-only: SQLite
# CERTMGR_DATABASE_URL=sqlite:///./certmgr-dev.db
CERTMGR_REDIS_URL=redis://127.0.0.1:6379/0
CERTMGR_CELERY_BROKER_URL=
CERTMGR_CELERY_RESULT_BACKEND=

# Storage (private keys encrypted at rest)
CERTMGR_STORAGE_ROOT=/var/lib/certmgr/certificates
CERTMGR_BACKUP_ROOT=/var/lib/certmgr/backups
CERTMGR_LOG_ROOT=/var/log/certmgr
CERTMGR_TEMP_WORKDIR=/var/lib/certmgr/tmp
CERTMGR_STORAGE_BACKEND=encrypted-filesystem

# Certbot / Let's Encrypt
CERTMGR_CERTBOT_BINARY=certbot
CERTMGR_CERTBOT_WORKDIR=/etc/letsencrypt
CERTMGR_DEFAULT_LETSENCRYPT_EMAIL=ssl-admin@example.com
CERTMGR_DEFAULT_STAGING=false

# Scheduler
CERTMGR_RENEWAL_THRESHOLD_DAYS=30
CERTMGR_RENEWAL_CRON=0 3 * * *
CERTMGR_DISCOVERY_CRON=30 2 * * *
CERTMGR_HEALTH_CRON=0 */4 * * *
CERTMGR_BACKUP_CRON=0 1 * * *

# Data retention — purge history older than N days (0 = keep forever).
# Bounds DB growth: execution logs dominate, then audit, then notifications.
CERTMGR_EXECUTION_RETENTION_DAYS=365
CERTMGR_AUDIT_RETENTION_DAYS=730
CERTMGR_NOTIFICATION_RETENTION_DAYS=365

# Notifications
CERTMGR_SMTP_HOST=localhost
CERTMGR_SMTP_PORT=587
CERTMGR_SMTP_USERNAME=
CERTMGR_SMTP_PASSWORD=
CERTMGR_SMTP_USE_TLS=true
CERTMGR_SMTP_FROM=certmgr@example.com

# Observability
CERTMGR_PROMETHEUS_ENABLED=true
CERTMGR_METRICS_AUTH_TOKEN=
CERTMGR_JSON_LOGGING=true
CERTMGR_LOG_LEVEL=INFO

# Rate limiting
CERTMGR_RATE_LIMIT_ENABLED=true
CERTMGR_RATE_LIMIT_LOGIN=10/minute
CERTMGR_RATE_LIMIT_API=300/minute

# AI assistant (optional, off by default)
CERTMGR_AI_ENABLED=false
CERTMGR_AI_API_KEY=

# Optional integrations
CERTMGR_VAULT_ENABLED=false
CERTMGR_VAULT_URL=https://vault:8200
CERTMGR_VAULT_TOKEN=
CERTMGR_VAULT_KV_PATH=secret/certmgr

# Deployment engine
CERTMGR_SSH_CONNECT_TIMEOUT=10
CERTMGR_SSH_COMMAND_TIMEOUT=120
CERTMGR_DEPLOYMENT_VERIFY_ENABLED=true
CERTMGR_DEPLOYMENT_ROLLBACK_ENABLED=true
